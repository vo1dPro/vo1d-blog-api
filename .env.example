# Copy and replace all <...> placeholders, or use pnpm setup:local for random LOCAL credentials.
NODE_ENV=development
# Steam owner libraries only. Keep all keys server-side.
# Optional JSON array of {name, steamId, apiKey}; overrides legacy single-account values when nonempty.
STEAM_ACCOUNTS=
# Legacy single-account fallback: configure both values before enabling.
STEAM_API_KEY=
STEAM_ID=
STEAM_SYNC_ENABLED=false
STEAM_SYNC_INTERVAL_SECONDS=300
STEAM_REQUEST_TIMEOUT_MS=15000
# Optional Node 24 proxy support: NODE_USE_ENV_PROXY=1, HTTPS_PROXY=http://<proxy-host>:<port>
# In Docker a host proxy uses host.docker.internal, not localhost. Never disable TLS checks.
# STEAM_DOCKER_HTTPS_PROXY=http://<docker-reachable-proxy-host>:<port>
# NO_PROXY=localhost,127.0.0.1,::1,minio,postgres
PORT=3100
DATABASE_URL=postgresql://<database-user>:<database-password>@<database-host>:<database-port>/<database-name>
TEST_DATABASE_URL=postgresql://<database-user>:<database-password>@<database-host>:<database-port>/<database-test-name>
# Exact origins only; no paths, trailing slash, or wildcard. Admin and API must be same-site with SameSite=Lax.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
# Enable only when exactly one trusted reverse proxy strips incoming forwarding headers.
TRUST_PROXY=false
BODY_LIMIT=1mb
SESSION_COOKIE_NAME=vo1d_admin_session
SESSION_TTL_HOURS=24
SESSION_TOUCH_INTERVAL_MINUTES=5
IP_HASH_SECRET=<random-at-least-32-characters>
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_BLOCK_SECONDS=300
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_PUBLIC_BASE_URL=https://<media-cdn-host>
S3_ENDPOINT=https://<s3-endpoint-host>
S3_REGION=auto
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_FORCE_PATH_STYLE=false
# Local Compose only. Keep these consistent with local DATABASE_URL / S3 variables.
POSTGRES_USER=<local-database-user>
POSTGRES_PASSWORD=<local-random-database-password>
POSTGRES_DB=<local-database-name>
POSTGRES_TEST_DB=<local-test-database-name>
POSTGRES_PORT=5433
MINIO_ROOT_USER=<local-minio-root-user>
MINIO_ROOT_PASSWORD=<local-random-minio-root-password>
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
