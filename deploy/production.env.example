# Merge into the server .env after backing it up. Do not overwrite local .env.
# Replace each __REPLACE_*__ with a DIFFERENT `openssl rand -hex 32` output.
# Hex passwords work directly in the Compose-generated PostgreSQL URL.
NODE_ENV=production
PORT=3100
API_PUBLIC_BASE_URL=https://api.vo1d.bot.cd
FRONTEND_ORIGINS=https://vo1d.bot.cd,https://admin.vo1d.bot.cd
TRUST_PROXY=true
BODY_LIMIT=1mb
SESSION_COOKIE_NAME=vo1d_admin_session
SESSION_TTL_HOURS=24
SESSION_TOUCH_INTERVAL_MINUTES=5
IP_HASH_SECRET=__REPLACE_IP_HASH_SECRET__
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_BLOCK_SECONDS=300

POSTGRES_USER=vo1d_blog
POSTGRES_PASSWORD=__REPLACE_POSTGRES_PASSWORD__
POSTGRES_DB=vo1d_blog
# Required by the existing Compose initialization script; never run tests on production.
POSTGRES_TEST_DB=vo1d_blog_test
POSTGRES_PORT=5433
# Compose overrides this with postgres:5432 inside api and migrate containers.
# For host-side tools, replace the password with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://vo1d_blog:__REPLACE_POSTGRES_PASSWORD__@127.0.0.1:5433/vo1d_blog

MINIO_ROOT_USER=vo1d_storage_root
MINIO_ROOT_PASSWORD=__REPLACE_MINIO_ROOT_PASSWORD__
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vo1d-media
# A separate bucket-scoped user, provisioned by minio-app-init.
S3_ACCESS_KEY_ID=vo1d_blog_app
S3_SECRET_ACCESS_KEY=__REPLACE_S3_SECRET_ACCESS_KEY__
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=10485760
# nginx.conf maps /objects/ to /vo1d-media/ on MinIO.
MEDIA_PUBLIC_BASE_URL=https://api.vo1d.bot.cd/objects

# Preserve existing Steam credentials/settings if already configured on the server.
STEAM_ACCOUNTS=
STEAM_API_KEY=
STEAM_ID=
STEAM_SYNC_ENABLED=false
STEAM_SYNC_INTERVAL_SECONDS=300
STEAM_REQUEST_TIMEOUT_MS=15000
STEAM_DOCKER_HTTPS_PROXY=
