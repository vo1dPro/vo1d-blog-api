{
  "name": "vo1d-blog-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready REST API for vo1d-blog",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "maintenance:prune": "tsx scripts/maintenance-prune.ts",
    "verify:smoke": "tsx scripts/verify-smoke.ts",
    "build": "prisma generate && nest build",
    "start": "node --env-file-if-exists=.env --use-system-ca dist/main.js",
    "start:dev": "node --env-file-if-exists=.env --use-system-ca node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:prod": "node --use-system-ca dist/main.js",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\" \"*.{ts,json,md,yml}\" \"docs/**/*.md\" && prisma format",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\" \"*.{ts,json,md,yml}\" \"docs/**/*.md\" && prisma validate",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "admin:create": "tsx scripts/admin-create.ts",
    "import:frontend": "tsx scripts/import-frontend.ts",
    "import:icons": "tsx scripts/import-icons.ts",
    "migrate:icons": "tsx scripts/migrate-database-icons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1125.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "file-type": "22.0.2",
    "helmet": "8.3.0",
    "marked": "18.0.11",
    "multer": "2.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.2",
    "unplugin-swc": "1.5.11",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
